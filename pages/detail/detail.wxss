page{background:#f8f5f0}.detail-page{min-height:100vh;background:#f8f5f0;color:#302c29}.loading{height:70vh;display:flex;align-items:center;justify-content:center;background:#e8e1d9;color:#756c66;font-size:24rpx}.album-stage{position:relative;width:100%;overflow:hidden;background:#e8e1d9;transition:height .28s ease}.album-swiper{width:100%;transition:height .28s ease}.slide{width:100%;height:100%;overflow:hidden}.slide image{display:block;width:100%;height:100%}.counter{position:absolute;right:24rpx;top:22rpx;background:rgba(39,32,29,.64);color:#fff;padding:10rpx 18rpx;border-radius:30rpx;font:20rpx Arial}.swipe-hint{position:absolute;left:50%;bottom:22rpx;transform:translateX(-50%);white-space:nowrap;background:rgba(39,32,29,.38);border-radius:30rpx;padding:9rpx 18rpx;color:rgba(255,255,255,.92);font-size:19rpx;letter-spacing:1rpx}.copy{padding:50rpx 38rpx 100rpx}.en{font:18rpx Arial;letter-spacing:4rpx;color:#9a655f}.title{font-size:50rpx;line-height:1.3;margin:18rpx 0}.category{font-size:23rpx;color:#8b817a}.note{font-size:26rpx;line-height:1.9;color:#6f6761;margin:36rpx 0}.line{border-top:1rpx solid #dcd5cf}.album-info{display:flex;justify-content:space-between;margin:20rpx 0 42rpx;font-size:21rpx;color:#948a83}.album-info text:last-child{color:#925b57}.copy button{background:#925b57;color:#fff;border-radius:0;font-size:24rpx;padding:18rpx}
.copy .share-button{margin-bottom:18rpx;background:transparent;color:#925b57;border:1rpx solid #b98681}
.copy .share-button::after{border:0}
