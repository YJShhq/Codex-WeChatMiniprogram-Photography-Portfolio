:host{display:block;height:calc(100vh - 270rpx);background:#f7f4ef}.service-browser{height:100%;display:grid;grid-template-columns:184rpx minmax(0,1fr)}.category-rail{background:#ebe8e3;border-right:1rpx solid #ddd8d2;padding:22rpx 0}.category-item{height:86rpx;display:flex;align-items:center;justify-content:center;position:relative;color:#554e49;font-size:24rpx;text-align:center}.category-item.active{background:#fff;color:#8f5551;font-weight:600}.active-line{display:none;position:absolute;left:0;width:6rpx;height:34rpx;background:#9a5e59}.category-item.active .active-line{display:block}.gallery-panel{height:100%;background:#fff}.gallery-head{padding:32rpx 20rpx 25rpx;border-bottom:1rpx solid #eee9e4}.gallery-head>text{display:block;font:15rpx Arial;letter-spacing:3rpx;color:#a06a64}.gallery-head>view{font-size:34rpx;margin:9rpx 0 4rpx}.gallery-head small{font:15rpx Arial;color:#aaa19a;letter-spacing:2rpx}.masonry-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30rpx 14rpx;padding:20rpx 16rpx}.portfolio-card{min-width:0}.portfolio-card image{display:block;width:100%;height:330rpx;background:#eee8e2}.portfolio-card:nth-child(4n+2) image,.portfolio-card:nth-child(4n+3) image{height:390rpx}.portfolio-card>text{display:block;margin-top:13rpx;font-size:17rpx;letter-spacing:1rpx;color:#9b625d}.portfolio-card>view{font-size:22rpx;line-height:1.45;margin-top:5rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.empty-state{padding:130rpx 24rpx;text-align:center;color:#746b65}.empty-mark{font-size:58rpx;color:#b78b85;margin-bottom:18rpx}.empty-state strong{display:block;font-size:26rpx;font-weight:500}.empty-state text{display:block;font-size:20rpx;line-height:1.7;color:#a09891;margin-top:14rpx}.bottom-space{height:40rpx}
