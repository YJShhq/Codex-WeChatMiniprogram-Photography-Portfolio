.page .hero-collage{display:block;height:720rpx;overflow:hidden}
.hero-collage .hero-swiper{width:100%;height:100%}
.hero-collage .hero-swiper swiper-item,.hero-collage .hero-swiper image{width:100%;height:100%;display:block}
.page .topbar{display:flex;align-items:center;justify-content:center;padding:42rpx 150rpx 0;box-sizing:border-box}
.brand-title{font-size:29rpx;font-weight:700;letter-spacing:1rpx;white-space:nowrap;color:#302c29}
.works-category-scroll{width:100%;margin:-16rpx 0 34rpx;white-space:nowrap}
.works-category-list{display:inline-flex;gap:14rpx;padding:2rpx 2rpx 8rpx}
.works-category-chip{flex:none;padding:13rpx 22rpx;border:1rpx solid #d9d0c8;background:#fff;color:#756b65;font-size:20rpx;line-height:1}
.works-category-chip.active{border-color:#955e59;background:#955e59;color:#fff}
.works-category-empty{padding:90rpx 0;text-align:center;color:#9a918a;font-size:22rpx}
.hero-collage .hero-tag{bottom:58rpx}
.hero-pagination{position:absolute;z-index:3;left:24rpx;right:24rpx;bottom:20rpx;display:flex;align-items:center;gap:18rpx;color:#fff;text-shadow:0 1rpx 5rpx rgba(0,0,0,.55)}
.hero-progress-track{height:5rpx;display:flex;flex:1;gap:8rpx}
.hero-progress-segment{height:100%;flex:1;background:rgba(255,255,255,.35);transition:background .3s ease,transform .3s ease}
.hero-progress-segment.active{background:#fff;transform:scaleY(1.5)}
.hero-pagination>text{min-width:62rpx;text-align:right;font:18rpx Arial;letter-spacing:1rpx}
